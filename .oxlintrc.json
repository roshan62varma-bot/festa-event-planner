{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "jsx-a11y", "import", "vitest"],
  "categories": { "correctness": "error", "suspicious": "warn" },
  "env": { "browser": true, "node": true, "es2022": true },
  "rules": { "react/react-in-jsx-scope": "off", "react/jsx-filename-extension": "off", "jsx-a11y/prefer-tag-over-role": "off", "import/no-unassigned-import": "off", "vitest/expect-expect": ["error", { "assertFunctionNames": ["expect", "expectNoAxeViolations"] }] },
  "ignorePatterns": ["dist/**", "coverage/**", "node_modules/**"]
}
